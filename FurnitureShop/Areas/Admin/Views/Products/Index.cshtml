@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>NvvQuản lí sản phẩm</h3>
    <a class="btn btn-primary" href="/Admin/Products/Create">+ Thêm</a>
</div>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên</th>
            <th>Giá</th>
            <th>Tồn</th>
            <th>Active</th>
            <th style="width:180px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td style="width:80px">
                    @if (!string.IsNullOrWhiteSpace(x.MainImageUrl))
                    {
                        <img src="@x.MainImageUrl"
                             style="width:70px;height:70px;object-fit:cover;border-radius:8px" />
                    }
                </td>
                <td>@x.Name<br /><small class="text-muted">@x.Slug</small></td>
                <td>@x.Price</td>
                <td>@x.Stock</td>
                <td>@(x.IsActive ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="/Admin/Products/Edit/@x.Id">Sửa</a>
                    <form class="d-inline" method="post" action="/Admin/Products/Delete/@x.Id" onsubmit="return confirm('Xoá sản phẩm?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger" type="submit">Xoá</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
