<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - FurnitureShop</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="border-bottom bg-white">
        <div class="container-fluid py-2 d-flex align-items-center justify-content-between">
            <div class="d-flex gap-3 align-items-center">
                <a class="fw-bold text-decoration-none" href="/Admin">Admin Panel</a>
                <a class="text-decoration-none" href="/">← Về trang bán hàng</a>
            </div>

            <div class="d-flex gap-2 align-items-center">
                <span class="small text-muted">Xin chào, @User.Identity?.Name</span>

                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger btn-sm" type="submit">Đăng xuất</button>
                </form>

            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <aside class="col-12 col-lg-2 border-end min-vh-100 p-0">
                @await Html.PartialAsync("_AdminNav")
            </aside>

            <main class="col-12 col-lg-10 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
