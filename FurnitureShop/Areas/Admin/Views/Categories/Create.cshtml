@model FurnitureShop.ViewModels.Admin.Categories.CategoryFormVm
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h3 class="mb-3">Thêm danh mục</h3>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">@Html.ValidationSummary()</div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Tên</label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Slug</label>
        <input class="form-control" asp-for="Slug" placeholder="tự sinh từ tên nếu để trống" />
        <span class="text-danger" asp-validation-for="Slug"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Danh mục cha</label>
        <select class="form-select" asp-for="ParentId">
            <option value="">-- Không có --</option>
            @foreach (var p in Model.ParentOptions)
            {
                <option value="@p.Id">@p.Text</option>
            }
        </select>
        <span class="text-danger" asp-validation-for="ParentId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <textarea class="form-control" asp-for="Description" rows="3"></textarea>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
        <label class="form-check-label">Kích hoạt</label>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Lưu</button>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="Categories" asp-action="Index">Hủy</a>
    </div>
</form>
