@model List<FurnitureShop.ViewModels.Admin.Categories.CategoryRowVm>
@{
    ViewData["Title"] = "Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Danh mục</h3>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Categories" asp-action="Create">+ Thêm danh mục</a>
</div>

@if (TempData["ok"] != null)
{
    <div class="alert alert-success">@TempData["ok"]</div>
}
@if (TempData["err"] != null)
{
    <div class="alert alert-danger">@TempData["err"]</div>
}

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Slug</th>
            <th>Cha</th>
            <th>Active</th>
            <th style="width:220px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name</td>
                <td><code>@r.Slug</code></td>
                <td>@(r.ParentName ?? "-")</td>
                <td>
                    @if (r.IsActive)
                    {
                        <span class="badge text-bg-success">ON</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">OFF</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary"
                       asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@r.Id">Sửa</a>

                    <form class="d-inline" method="post"
                          asp-area="Admin" asp-controller="Categories" asp-action="ToggleActive" asp-route-id="@r.Id">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-warning" type="submit">
                            @(r.IsActive ? "Tắt" : "Bật")
                        </button>
                    </form>

                    <a class="btn btn-sm btn-outline-danger"
                       asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@r.Id">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
