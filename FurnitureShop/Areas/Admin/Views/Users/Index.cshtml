@using FurnitureShop.Models.Enums
@model FurnitureShop.ViewModels.Admin.Users.AdminUserListVm

@{
    ViewData["Title"] = "Users";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<h2 class="mb-3">Users</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" name="q" value="@Model.Q" placeholder="Tìm theo username/email..." />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" type="submit">Tìm</button>
    </div>
    <div class="col-md-2">
        <a class="btn btn-outline-secondary w-100" href="/Admin/Users">Reset</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>UserName</th>
                <th>Email</th>
                <th>FullName</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Active</th>
                <th style="width:260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">@u.UserName</td>
                    <td>@u.Email</td>
                    <td>@u.FullName</td>
                    <td>@u.Phone</td>
                    <td>
                        <span class="badge @(u.Role == (byte)UserRole.Admin ? "bg-danger" : "bg-secondary")">
                            @(u.Role == (byte)UserRole.Admin ? "Admin" : "Customer")
                        </span>
                    </td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-dark">Locked</span>
                        }
                    </td>
                    <td class="d-flex gap-2">
                        <form method="post" asp-area="Admin" asp-controller="Users" asp-action="ToggleActive">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                @(u.IsActive ? "Khóa" : "Mở khóa")
                            </button>
                        </form>

                        <a class="btn btn-sm btn-outline-secondary"
                           asp-area="Admin" asp-controller="Users" asp-action="Detail"
                           asp-route-id="@u.Id">
                            Chi tiết
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    var totalPages = (int)Math.Ceiling(Model.Total / (double)Model.PageSize);
}
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int p = 1; p <= totalPages; p++)
            {
                var active = p == Model.Page ? "active" : "";
                <li class="page-item @active">
                    <a class="page-link" href="/Admin/Users?q=@Model.Q&page=@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
