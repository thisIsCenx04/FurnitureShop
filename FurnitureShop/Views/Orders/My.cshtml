@model List<FurnitureShop.ViewModels.Orders.MyOrdersItemVm>
@using FurnitureShop.Helpers

<h2>Đơn hàng của tôi</h2>

@if (!Model.Any())
{
    <p>Bạn chưa có đơn hàng nào.</p>
    <a class="btn btn-primary" href="/products">Mua sắm</a>
    return;
}

<table class="table">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Ngày</th>
            <th>Trạng thái</th>
            <th>Tổng</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.OrderCode</td>
                <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <span class="badge @OrderStatusHelper.ToBadgeClass(o.Status)">
                        @OrderStatusHelper.ToText(o.Status)
                    </span>
                </td>
                <td>@o.Total.ToString("n0") đ</td>
                <td><a class="btn btn-sm btn-outline-primary" href="/orders/@o.Id">Chi tiết</a></td>
            </tr>
        }
    </tbody>
</table>
