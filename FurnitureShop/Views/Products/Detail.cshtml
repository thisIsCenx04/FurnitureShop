@model FurnitureShop.ViewModels.Products.ProductDetailVm
@using FurnitureShop.Helpers

@{
    ViewData["Title"] = Model.Name;
    string placeholder = "/images/placeholder.png";
    var main = string.IsNullOrWhiteSpace(Model.MainImageUrl) ? placeholder : Model.MainImageUrl!;
}

<div class="mb-3">
    <a href="/products" class="text-decoration-none">← Quay lại</a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-6">

        <div class="border rounded overflow-hidden">
            <img src="@main" alt="@Model.Name" style="width:100%; aspect-ratio: 4/3; object-fit: cover;" />
        </div>

        @if (Model.Gallery.Any())
        {
            <div class="d-flex flex-wrap gap-2 mt-2">
                @foreach (var img in Model.Gallery)
                {
                    <img src="@img.Url"
                         alt="gallery"
                         style="width:90px; height:70px; object-fit:cover; border-radius:8px; border:1px solid #ddd;" />
                }
            </div>
        }
    </div>

    <div class="col-12 col-lg-6">
        <div class="text-muted small">@Model.CategoryName</div>
        <h2 class="mb-2">@Model.Name</h2>

        <div class="mb-3">
            @if (Model.SalePrice.HasValue)
            {
                <div class="text-decoration-line-through text-muted">@Model.Price.ToVnd()</div>
                <div class="fs-4 fw-bold">@Model.SalePrice.Value.ToVnd()</div>
            }
            else
            {
                <div class="fs-4 fw-bold">@Model.Price.ToVnd()</div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
        {
            <p class="text-muted">@Model.ShortDescription</p>
        }

        <div class="border rounded p-3 mb-3">
            <div><b>Chất liệu:</b> @(Model.Material ?? "—")</div>
            <div><b>Kích thước:</b> @(Model.Dimensions ?? "—")</div>
            <div><b>Phong cách:</b> @(Model.Style ?? "—")</div>
            <div><b>Tồn kho:</b> @Model.Stock</div>
        </div>

        <!-- Module 3 sẽ gắn AddToCart ở đây -->
        <button class="btn btn-primary" disabled>Thêm vào giỏ (Module 3)</button>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <hr />
            <h5>Mô tả</h5>
            <div style="white-space: pre-line;">@Model.Description</div>
        }
    </div>
</div>
