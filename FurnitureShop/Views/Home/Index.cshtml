@model FurnitureShop.ViewModels.Home.HomeIndexVm
@using FurnitureShop.Helpers

@{
    ViewData["Title"] = "Trang chủ";
    string placeholder = "/images/placeholder.png";
}

<!-- Hero Section -->
<div class="hero-section mb-5">
    <div class="text-center mb-5">
        <h1 class="display-4 mb-3">
            <i class="fas fa-couch me-3" style="color: var(--accent);"></i>
            FurnitureShop
        </h1>
        <p class="lead text-muted mb-4">
            Nội thất cao cấp - Thiết kế hiện đại - Giá tốt nhất
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/products" class="btn btn-primary btn-lg px-4">
                <i class="fas fa-shopping-bag me-2"></i>
                Khám phá ngay
            </a>
            <a href="#categories" class="btn btn-outline-primary btn-lg px-4">
                <i class="fas fa-list me-2"></i>
                Danh mục
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="card text-center glass-effect animate-scale-in">
                <div class="card-body">
                    <i class="fas fa-box-open fa-2x text-primary mb-2"></i>
                    <h4 class="fw-bold mb-1">500+</h4>
                    <p class="text-muted mb-0 small">Sản phẩm</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center glass-effect animate-scale-in" style="animation-delay: 0.1s;">
                <div class="card-body">
                    <i class="fas fa-users fa-2x text-success mb-2"></i>
                    <h4 class="fw-bold mb-1">1000+</h4>
                    <p class="text-muted mb-0 small">Khách hàng</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center glass-effect animate-scale-in" style="animation-delay: 0.2s;">
                <div class="card-body">
                    <i class="fas fa-star fa-2x text-warning mb-2"></i>
                    <h4 class="fw-bold mb-1">4.9/5</h4>
                    <p class="text-muted mb-0 small">Đánh giá</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center glass-effect animate-scale-in" style="animation-delay: 0.3s;">
                <div class="card-body">
                    <i class="fas fa-shipping-fast fa-2x text-info mb-2"></i>
                    <h4 class="fw-bold mb-1">24h</h4>
                    <p class="text-muted mb-0 small">Giao hàng</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Categories Section -->
<div id="categories" class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-th-large me-2 text-primary"></i>
                Danh mục nổi bật
            </h2>
            <p class="text-muted mb-0">Khám phá các danh mục sản phẩm của chúng tôi</p>
        </div>
        <a href="/products" class="btn btn-outline-primary">
            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4 mb-5">
        @{ int categoryIndex = 0; }
        @foreach (var c in Model.Categories)
        {
            var url = $"/products?Categories={Uri.EscapeDataString(c.Slug)}";
            var gradients = new[] {
                "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
                "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
                "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
                "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)",
                "linear-gradient(135deg, #fa709a 0%, #fee140 100%)",
                "linear-gradient(135deg, #30cfd0 0%, #330867 100%)"
            };
            var gradient = gradients[categoryIndex % gradients.Length];

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card position-relative" style="background: @gradient;">
                    <div class="position-relative" style="z-index: 1;">
                        <h5 class="mb-2">
                            <i class="fas fa-folder-open me-2"></i>
                            @c.Name
                        </h5>
                        <p class="category-count mb-3">
                            <i class="fas fa-box me-1"></i>
                            Xem sản phẩm
                        </p>
                        <a href="@url" class="btn btn-light btn-sm">
                            Khám phá ngay <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <a class="stretched-link" href="@url"></a>
                </div>
            </div>
            categoryIndex++;
        }
    </div>
</div>

<!-- Products Section -->
<div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-fire me-2 text-danger"></i>
                Sản phẩm mới
            </h2>
            <p class="text-muted mb-0">Những sản phẩm mới nhất và hot nhất</p>
        </div>
        <a href="/products" class="btn btn-outline-primary">
            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var p in Model.Products)
        {
            var img = string.IsNullOrWhiteSpace(p.MainImageUrl) ? placeholder : p.MainImageUrl;
            var url = $"/products/{p.Slug}";
            var hasSale = p.SalePrice.HasValue && p.SalePrice.Value < p.Price;

            <div class="col-6 col-md-4 col-lg-3">
                <div class="card product-card position-relative">
                    @if (hasSale)
                    {
                        var discount = Math.Round((1 - p.SalePrice.Value / p.Price) * 100);
                        <div class="product-badge">
                            <i class="fas fa-fire me-1"></i>-@(discount)%
                        </div>
                    }

                    <div style="position: relative; overflow: hidden;">
                        <img class="card-img-top"
                             src="@img"
                             alt="@p.Name"
                             style="aspect-ratio:4/3; object-fit:cover;" 
                             onerror="this.src='/images/placeholder.png'" />
                    </div>

                    <div class="card-body">
                        <h6 class="fw-semibold mb-2 text-truncate" title="@p.Name">
                            @p.Name
                        </h6>
                        
                        @if (p.Material != null)
                        {
                            <p class="text-muted small mb-2">
                                <i class="fas fa-leaf me-1"></i>@p.Material
                            </p>
                        }

                        <div class="product-price">
                            @if (hasSale)
                            {
                                <span class="price-original">@p.Price.ToVnd()</span>
                                <span class="price-sale">@p.SalePrice!.Value.ToVnd()</span>
                            }
                            else
                            {
                                <span class="price-regular">@p.Price.ToVnd()</span>
                            }
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <a href="@url" class="btn btn-primary btn-sm flex-grow-1">
                                <i class="fas fa-eye me-1"></i> Xem
                            </a>
                            <button class="btn btn-outline-primary btn-sm" onclick="addToCart(@p.Id, event)">
                                <i class="fas fa-shopping-cart"></i>
                            </button>
                        </div>
                    </div>

                    <a class="stretched-link" href="@url"></a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Features Section -->
<div class="row g-4 mt-5 mb-5">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 text-center h-100 glass-effect">
            <div class="card-body py-4">
                <div class="mb-3">
                    <i class="fas fa-shipping-fast fa-3x text-primary"></i>
                </div>
                <h5 class="fw-bold mb-2">Miễn phí vận chuyển</h5>
                <p class="text-muted small mb-0">Cho đơn hàng từ 5 triệu</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 text-center h-100 glass-effect">
            <div class="card-body py-4">
                <div class="mb-3">
                    <i class="fas fa-undo-alt fa-3x text-success"></i>
                </div>
                <h5 class="fw-bold mb-2">Đổi trả dễ dàng</h5>
                <p class="text-muted small mb-0">Trong vòng 30 ngày</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 text-center h-100 glass-effect">
            <div class="card-body py-4">
                <div class="mb-3">
                    <i class="fas fa-shield-alt fa-3x text-warning"></i>
                </div>
                <h5 class="fw-bold mb-2">Bảo hành chính hãng</h5>
                <p class="text-muted small mb-0">Bảo hành 2 năm</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 text-center h-100 glass-effect">
            <div class="card-body py-4">
                <div class="mb-3">
                    <i class="fas fa-headset fa-3x text-info"></i>
                </div>
                <h5 class="fw-bold mb-2">Hỗ trợ 24/7</h5>
                <p class="text-muted small mb-0">Tư vấn nhiệt tình</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId, event) {
            event.preventDefault();
            event.stopPropagation();
            
            // TODO: Implement add to cart logic
            alert('Thêm sản phẩm vào giỏ hàng: ' + productId);
        }
    </script>
}
