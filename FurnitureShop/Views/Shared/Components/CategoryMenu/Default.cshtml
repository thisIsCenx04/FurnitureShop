@model List<FurnitureShop.ViewComponents.CategoryMenuViewComponent.Node>

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle"
       href="#"
       role="button"
       data-bs-toggle="dropdown"
       aria-expanded="false">
        Danh mục
    </a>

    <ul class="dropdown-menu p-2" style="min-width:320px; max-height:70vh; overflow:auto;">
        @foreach (var root in Model)
        {
            @await Html.PartialAsync("_CategoryTreeNode", root, new ViewDataDictionary(ViewData)
            {
            ["Level"] = 0
                })
                }
    </ul>
</li>
