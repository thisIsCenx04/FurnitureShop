@model FurnitureShop.ViewModels.Cart.CartSummaryVm

<h2>Giỏ hàng</h2>

@if (TempData["CartError"] != null)
{
    <div class="alert alert-danger">@TempData["CartError"]</div>
}
@if (TempData["CartMsg"] != null)
{
    <div class="alert alert-success">@TempData["CartMsg"]</div>
}

@if (!Model.Items.Any())
{
    <p>Giỏ hàng trống.</p>
    <a class="btn btn-primary" href="/products">Mua sắm</a>
    return;
}

<form id="af-token" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<table class="table align-middle cart-table">
    <colgroup>
        <col style="width:90px" />
        <col />
        <col style="width:160px" />
        <col style="width:180px" />
        <col style="width:190px" />
        <col style="width:100px" />
    </colgroup>
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Sản phẩm</th>
            <th class="text-end">Giá</th>
            <th class="text-center">Số lượng</th>
            <th class="text-end">Tạm tính</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var it in Model.Items)
        {
            var img = string.IsNullOrWhiteSpace(it.ImageUrl) ? "/images/placeholder.png" : it.ImageUrl;

            <tr>
                <td>
                    <a href="/products/@it.ProductSlug">
                        <img src="@img" alt="@it.ProductName"
                             style="width:72px;height:72px;object-fit:cover;border-radius:8px;" />
                    </a>
                </td>

                <td class="product-cell">
                    <a class="product-name" href="/products/@it.ProductSlug">@it.ProductName</a>
                    <div class="text-muted small">Còn: @it.Stock</div>
                    @if (it.Stock <= 0)
                    {
                        <span class="badge bg-danger">Hết hàng</span>
                    }
                </td>

                <td class="money">@it.UnitPrice.ToString("n0") đ</td>

                <td class="text-center">
                    <div class="d-inline-flex align-items-center gap-2 qty-box">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm qty-btn"
                                data-id="@it.CartItemId"
                                data-delta="-1"
                                @(it.Quantity <= 1 ? "disabled" : "")>
                            −
                        </button>

                        <input type="text"
                               class="form-control text-center qty-input"
                               value="@it.Quantity"
                               readonly />

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm qty-btn"
                                data-id="@it.CartItemId"
                                data-delta="1"
                                @(it.Quantity >= it.Stock ? "disabled" : "")>
                            +
                        </button>
                    </div>
                </td>

                <td class="money">@it.LineTotal.ToString("n0") đ</td>

                <td class="text-end">
                    <form method="post" action="/cart/remove" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cartItemId" value="@it.CartItemId" />
                        <button class="btn btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-end">
    <div class="cart-summary">
        <div class="d-flex justify-content-between">
            <span>Tạm tính</span>
            <strong class="money">@Model.Subtotal.ToString("n0") đ</strong>
        </div>
        <a class="btn btn-primary w-100 mt-3" href="/checkout">Thanh toán (COD)</a>
    </div>
</div>
