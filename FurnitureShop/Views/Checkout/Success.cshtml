@model FurnitureShop.Models.Entities.Order

<h2>Đặt hàng thành công 🎉</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Mã đơn:</strong> @Model.OrderCode</p>
        <p><strong>Trạng thái:</strong> @Model.Status</p>
        <p><strong>Thanh toán:</strong> COD</p>
        <p><strong>Tổng tiền:</strong> @Model.Total.ToString("n0") đ</p>
        <p><strong>Giao tới:</strong> @Model.Address</p>

        <div class="mt-3 d-flex gap-2">
            <a class="btn btn-primary" href="/products">Tiếp tục mua sắm</a>
            <a class="btn btn-outline-secondary" href="/orders/@Model.Id">Xem chi tiết đơn</a>
        </div>
    </div>
</div>
